{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Terry-Kao/Autonomous-Research-Agent-Protocol/schemas/project-state.schema.json",
  "title": "ARAP Project State",
  "type": "object",
  "required": ["project", "phase", "status", "next_action"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "status": {"enum": ["PLANNED", "RUNNING", "PASS", "REVISE", "BLOCKED"]},
    "next_action": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}

